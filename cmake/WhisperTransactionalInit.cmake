# Narrow, idempotent overlay for whisper.cpp 927cfce34f31707e17f2bff35c349632fb9e2c3a.
# Fail closed if a future pin no longer has the reviewed ownership shape.
function(timmy_patch_whisper_init source)
    file(READ "${source}" content)
    if(content MATCHES "TIMMY transactional GPU initialization")
        return()
    endif()
    file(SHA256 "${source}" source_hash)
    if(NOT source_hash STREQUAL "c48686fbc2cba1b0ac0f9c8e964188c691e67fff5906f2629f3223ff64f92d16")
        message(FATAL_ERROR "Whisper initialization overlay requires the reviewed v1.9.4 source file.")
    endif()
    set(old "static std::vector<ggml_backend_t> whisper_backend_init(const whisper_context_params & params) {\n    std::vector<ggml_backend_t> result;")
    set(new "// TIMMY transactional GPU initialization\nstatic void whisper_backend_init(const whisper_context_params & params, std::vector<ggml_backend_t> & result) {")
    string(FIND "${content}" "${old}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Pinned Whisper initialization overlay no longer matches; review the dependency pin.")
    endif()
    string(REPLACE "${old}" "${new}" content "${content}")
    string(REPLACE "    ggml_backend_t backend_gpu = whisper_backend_init_gpu(params);"
        "    ggml_backend_t backend_gpu = whisper_backend_init_gpu(params);\n    if (params.use_gpu && !backend_gpu) {\n        throw std::runtime_error(\"requested GPU backend failed to initialize\");\n    }" content "${content}")
    string(REPLACE "    return result;\n}\n\nusing buft_list_t" "}\n\nusing buft_list_t" content "${content}")
    string(FIND "${content}" "struct whisper_state * whisper_init_state(whisper_context * ctx) {" start)
    string(FIND "${content}" "struct whisper_context_params whisper_context_default_params" finish)
    if(start EQUAL -1 OR finish EQUAL -1)
        message(FATAL_ERROR "Pinned Whisper state ownership overlay no longer matches.")
    endif()
    math(EXPR length "${finish} - ${start}")
    string(SUBSTRING "${content}" ${start} ${length} original)
    set(state "${original}")
    string(REPLACE "    whisper_state * state = new whisper_state;"
        "    std::unique_ptr<whisper_state, decltype(&whisper_free_state)> owned(new whisper_state{}, whisper_free_state);\n    whisper_state * state = owned.get();\n    try {" state "${state}")
    string(REPLACE "    state->backends = whisper_backend_init(ctx->params);"
        "    whisper_backend_init(ctx->params, state->backends);" state "${state}")
    string(REPLACE "whisper_free_state(state);" "/* owned releases partial state */" state "${state}")
    string(REPLACE "    return state;\n}" "    return owned.release();\n    } catch (...) {\n        return nullptr;\n    }\n}" state "${state}")
    string(REPLACE "${original}" "${state}" content "${content}")
    string(REPLACE "    vctx->backends = whisper_backend_init(whisper_context_params);"
        "    whisper_backend_init(whisper_context_params, vctx->backends);" content "${content}")
    string(REPLACE "        delete ctx;\n        return nullptr;" "        whisper_free(ctx);\n        return nullptr;" content "${content}")
    file(WRITE "${source}" "${content}")
endfunction()
