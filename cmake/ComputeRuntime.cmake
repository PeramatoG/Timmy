# Stage one serial set of copies for all executables, including nested tests.
# The Vulkan module is a build dependency, never a link dependency.
function(timmy_collect_runtime_targets directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(type STREQUAL "EXECUTABLE" AND target MATCHES "^timmy_")
            set_property(GLOBAL APPEND PROPERTY TIMMY_RUNTIME_TARGETS ${target})
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        timmy_collect_runtime_targets("${child}")
    endforeach()
endfunction()

function(timmy_stage_directory directory)
    if(NOT TIMMY_ENABLE_VULKAN)
        return()
    endif()
    timmy_collect_runtime_targets("${directory}")
    get_property(targets GLOBAL PROPERTY TIMMY_RUNTIME_TARGETS)
    set(commands)
    set(libraries whisper ggml ggml-base ggml-cpu ggml-vulkan)
    if(TARGET ggml-blas)
        list(APPEND libraries ggml-blas)
    endif()
    if(APPLE)
        set(origin "@loader_path")
    elseif(UNIX)
        set(origin "$ORIGIN")
    endif()
    if(UNIX)
        foreach(library IN LISTS libraries)
            set_target_properties(${library} PROPERTIES
                BUILD_RPATH "${origin}" INSTALL_RPATH "${origin}" BUILD_RPATH_USE_ORIGIN TRUE)
        endforeach()
        foreach(target IN LISTS targets)
            set_target_properties(${target} PROPERTIES
                BUILD_RPATH "${origin}" INSTALL_RPATH "${origin}" BUILD_RPATH_USE_ORIGIN TRUE)
        endforeach()
    endif()
    foreach(target IN LISTS targets)
        list(APPEND commands COMMAND ${CMAKE_COMMAND} -E make_directory $<TARGET_FILE_DIR:${target}>)
        foreach(library IN LISTS libraries)
            list(APPEND commands COMMAND ${CMAKE_COMMAND} -E copy_if_different
                $<TARGET_FILE:${library}> $<TARGET_FILE_DIR:${target}>)
            if(UNIX AND NOT library STREQUAL "ggml-vulkan")
                list(APPEND commands COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    $<TARGET_SONAME_FILE:${library}> $<TARGET_FILE_DIR:${target}>)
            endif()
        endforeach()
    endforeach()
    add_custom_target(timmy_compute_runtime ALL ${commands}
        DEPENDS ${libraries} VERBATIM)
    foreach(target IN LISTS targets)
        add_dependencies(${target} timmy_compute_runtime)
    endforeach()
endfunction()
