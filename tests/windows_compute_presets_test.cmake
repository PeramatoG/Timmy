file(READ "${SOURCE_DIR}/CMakePresets.json" presets)
string(JSON count LENGTH "${presets}" configurePresets)
math(EXPR last "${count} - 1")
set(checked)
foreach(index RANGE 0 ${last})
    string(JSON name GET "${presets}" configurePresets ${index} name)
    if(name STREQUAL "windows-debug" OR name STREQUAL "windows-release")
        string(JSON enabled GET "${presets}" configurePresets ${index} cacheVariables TIMMY_ENABLE_VULKAN)
        if(NOT enabled STREQUAL "ON")
            message(FATAL_ERROR "${name} must explicitly enable TIMMY_ENABLE_VULKAN")
        endif()
        list(APPEND checked "${name}")
    endif()
endforeach()
list(LENGTH checked checked_count)
if(NOT checked_count EQUAL 2)
    message(FATAL_ERROR "Both Windows presets must exist")
endif()

# Guard the option declaration independently of the build's cache override.
file(READ "${SOURCE_DIR}/modules/asr/CMakeLists.txt" asr_cmake)
if(NOT asr_cmake MATCHES "option\\([ \t\r\n]*TIMMY_ENABLE_VULKAN[ \t\r\n]+\"[^\"]*\"[ \t\r\n]+OFF[ \t\r\n]*\\)")
    message(FATAL_ERROR "The global TIMMY_ENABLE_VULKAN default must remain OFF")
endif()
